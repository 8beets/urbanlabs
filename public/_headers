/images/*
  Cache-Control: public, max-age=3600, must-revalidate

/fonts/*
  Cache-Control: public, max-age=3600, must-revalidate

/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

# Prerendered pages and the search index change with every build; browsers keep a
# copy but revalidate it (cheap with the asset ETag) so a new build shows at once.
/es/*
  Cache-Control: public, max-age=0, must-revalidate

/ca/*
  Cache-Control: public, max-age=0, must-revalidate

/search/*
  Cache-Control: public, max-age=0, must-revalidate
