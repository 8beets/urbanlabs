{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnaprop",
  "account_id": "3e956f73c2ce2c6bad7638a31ab76d99",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learnaprop-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Local development and E2E only: Turnstile's documented always-pass test keys, a
  // throwaway token secret, and the log email adapter. Vars are not inherited by envs.
  "vars": {
    "EMAIL_PROVIDER": "log",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
    "ALERT_TOKEN_SECRET": "local-development-only-not-a-real-secret-000",
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "env": {
    "production": {
      "name": "learnaprop",
      "workers_dev": true,
      "preview_urls": false,
      // Alerts stay hidden until TURNSTILE_SITE_KEY and EMAIL_FROM are added here and the
      // BREVO_API_KEY, TURNSTILE_SECRET_KEY and ALERT_TOKEN_SECRET secrets exist (docs/deployment.md).
      "vars": { "EMAIL_PROVIDER": "brevo" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learnaprop",
          "database_id": "1b9916a8-60ff-4d90-8e10-94216c4e9723",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
