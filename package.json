{
  "name": "urbanlabs",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "deploy:production": "npm run build:production && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:production": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:types": "wrangler types --config wrangler.jsonc --include-runtime false",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "source:verify": "tsx scripts/verify-source.ts",
    "centre:probe": "tsx scripts/probe-centre.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:live": "tsx scripts/ingest.ts --live",
    "ingest:production": "tsx scripts/ingest-production.ts",
    "ingest:plan": "tsx scripts/ingest-plan.ts",
    "centres:sync": "tsx scripts/sync-centres.ts",
    "centres:sync:production": "tsx scripts/sync-centres.ts --remote",
    "i18n:compile": "paraglide-js compile",
    "pretypecheck": "npm run i18n:compile",
    "pretest": "npm run i18n:compile"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.5",
    "@date-fns/tz": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
