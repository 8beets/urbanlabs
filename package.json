{
  "name": "urbanlabs",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "check:build": "tsx src/commands/index.ts check-build",
    "deploy:production": "npm run db:migrate:production && npm run snapshot:production && npm run build:production && npm run check:build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:production": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote",
    "snapshot": "tsx src/commands/index.ts snapshot",
    "snapshot:production": "tsx src/commands/index.ts snapshot --remote",
    "snapshot:fixture": "node --import tsx tests/e2e/setup.ts",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e:build": "npm run snapshot:fixture && URBANLABS_SNAPSHOT=.cache/e2e-snapshot.json astro build",
    "test:e2e": "npm run e2e:build && playwright test",
    "e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:types": "wrangler types --config wrangler.jsonc --include-runtime false",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "check": "npm run format:check && npm run lint && npm run db:types && npm run typecheck && npm test && npm run test:d1 && npm run db:migrate && npm run e2e:build && npm run check:build && npm run e2e",
    "cli": "tsx src/commands/index.ts",
    "source:verify": "tsx src/commands/index.ts source-verify",
    "centre:probe": "tsx src/commands/index.ts centre-probe",
    "ingest": "tsx src/commands/index.ts ingest",
    "ingest:live": "tsx src/commands/index.ts ingest --live",
    "ingest:production": "tsx src/commands/index.ts ingest --remote",
    "ingest:plan": "tsx src/commands/index.ts ingest-plan",
    "freshness": "tsx src/commands/index.ts freshness",
    "alerts:send": "tsx src/commands/index.ts alerts-send",
    "centres:sync": "tsx src/commands/index.ts centres-sync",
    "centres:sync:production": "tsx src/commands/index.ts centres-sync --remote",
    "i18n:compile": "paraglide-js compile",
    "pretypecheck": "npm run i18n:compile",
    "pretest": "npm run i18n:compile"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.5",
    "@date-fns/tz": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
