---
import { m } from '../paraglide/messages.js';
import { locales } from '../paraglide/runtime.js';
import {
  centreDirectoryPath,
  citiesCentresPath,
  citiesCoursesPath,
  courseSearchPath,
  homePath,
  aboutPath,
} from '../i18n/paths';
import { coveredCities, sourceCityLabels } from '../i18n/geography';
import { geographyCity } from '../lib/locations/registry';
import { type Locale } from '../i18n/ui';
import { jsonLd, OG_LOCALES, pageLinks } from '../lib/seo';
import '../styles/global.css';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  languagePaths: Record<Locale, string>;
  section?: 'home' | 'courses' | 'centres' | 'none';
  /**
   * False for pages that must stay out of search results (alert sign-up and token
   * pages, the 404): they get noindex and no canonical or hreflang links.
   */
  indexable?: boolean;
  /** schema.org JSON-LD, only with facts the page actually shows. */
  structuredData?: object;
}
const {
  locale,
  title,
  description,
  languagePaths,
  section = 'home',
  indexable = true,
  structuredData,
} = Astro.props;
const metaDescription =
  description ?? m.description({ cities: coveredCities(locale) }, { locale });
const links = indexable ? pageLinks(locale, languagePaths) : null;
const base = homePath(locale);
// "Cursos" and "Centros" open a list of cities (docs/adr/0010-city-sections.md).
const cities = sourceCityLabels(locale);
// Attribution some cities' open-data terms require (data/geography.json).
const credits = cities.flatMap((city) => {
  const credit = geographyCity(city.id)?.dataCredit;
  return credit
    ? [{ city: city.label, url: credit.url, name: credit.names[locale] }]
    : [];
});
const menus = [
  {
    section: 'courses',
    label: m.coursesNav({}, { locale }),
    all: citiesCoursesPath(locale),
    path: (city: string) => courseSearchPath(locale, city),
  },
  {
    section: 'centres',
    label: m.centresNav({}, { locale }),
    all: citiesCentresPath(locale),
    path: (city: string) => centreDirectoryPath(locale, city),
  },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    {!indexable && <meta name="robots" content="noindex,follow" />}
    {links && (
      <>
        <link rel="canonical" href={links.canonical} />
        {links.alternates.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate.hreflang}
            href={alternate.href}
          />
        ))}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="UrbanLabs" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={links.canonical} />
        <meta property="og:locale" content={OG_LOCALES[locale]} />
        {locales
          .filter((other) => other !== locale)
          .map((other) => (
            <meta property="og:locale:alternate" content={OG_LOCALES[other]} />
          ))}
      </>
    )}
    {indexable && structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={jsonLd(structuredData)}
      />
    )}
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/learnaprop-logo.png"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {m.skip({}, { locale })}
    </a>
    <header class="shell header">
      <a href={base} class="brand">
        <img
          src="/images/brand/learnaprop-logo.png"
          alt=""
          width="56"
          height="56"
        />
        UrbanLabs
      </a>
      <div class="header-actions">
        <nav
          class="primary-nav"
          aria-label={m.primaryNavigation({}, { locale })}
        >
          <a href={base} aria-current={section === 'home' ? 'page' : undefined}>
            {m.homeNav({}, { locale })}
          </a>
          {menus.map((menu) => (
            <details
              class="nav-menu"
              name="nav-menu"
              data-current={section === menu.section ? 'true' : undefined}
            >
              <summary>{menu.label}</summary>
              <ul>
                {cities.map((city) => (
                  <li>
                    <a href={menu.path(city.id)}>{city.label}</a>
                  </li>
                ))}
                <li>
                  <a href={menu.all}>{m.allCitiesNav({}, { locale })}</a>
                </li>
              </ul>
            </details>
          ))}
        </nav>
        <nav class="language-nav" aria-label={m.language({}, { locale })}>
          {locales.map((target) => (
            <a
              href={languagePaths[target]}
              lang={target}
              aria-current={target === locale ? 'page' : undefined}
            >
              {m.languageName({}, { locale: target })}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="shell footer">
      <div class="footer-main">
        <div class="footer-about">
          <p class="footer-brand">UrbanLabs</p>
          <p>{m.footer({}, { locale })}</p>
        </div>
        <div class="footer-links">
          <a href={aboutPath(locale)}>{m.aboutNav({}, { locale })}</a>
          <a class="github-link" href="https://github.com/8beets/urbanlabs">
            <img src="/icons/github.svg" alt="" width="20" height="20" />
            {m.githubRepo({}, { locale })}
          </a>
        </div>
      </div>
      <div class="footer-credits">
        {credits.length > 0 && (
          <section aria-labelledby="footer-data-sources">
            <h2 id="footer-data-sources" class="footer-heading">
              {m.dataSources({}, { locale })}
            </h2>
            <ul class="credit-list">
              {credits.map((credit) => (
                <li>
                  <span class="credit-city">{credit.city}</span>
                  <a href={credit.url}>{credit.name}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="photo-credit">
          {m.photoNote({}, { locale })}{' '}
          <a href="https://www.pexels.com/">{m.photoCredits({}, { locale })}</a>
          .
        </p>
      </div>
    </footer>
  </body>
</html>
