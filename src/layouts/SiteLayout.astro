---
import { m } from '../paraglide/messages.js';
import {
  centreDirectoryPath,
  citiesCentresPath,
  citiesCoursesPath,
  courseSearchPath,
  homePath,
  aboutPath,
} from '../i18n/paths';
import { coveredCities, sourceCityLabels } from '../i18n/geography';
import { geographyCity } from '../lib/locations/registry';
import { type Locale } from '../i18n/ui';
import '../styles/global.css';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  languagePaths: Record<Locale, string>;
  section?: 'home' | 'courses' | 'centres' | 'none';
}
const {
  locale,
  title,
  description,
  languagePaths,
  section = 'home',
} = Astro.props;
const base = homePath(locale);
// "Cursos" and "Centros" open a list of cities (docs/adr/0010-city-sections.md).
const cities = sourceCityLabels(locale);
// Attribution some cities' open-data terms require (data/geography.json).
const credits = cities.flatMap((city) => {
  const credit = geographyCity(city.id)?.dataCredit;
  return credit
    ? [{ city: city.label, url: credit.url, name: credit.names[locale] }]
    : [];
});
const menus = [
  {
    section: 'courses',
    label: m.coursesNav({}, { locale }),
    all: citiesCoursesPath(locale),
    path: (city: string) => courseSearchPath(locale, city),
  },
  {
    section: 'centres',
    label: m.centresNav({}, { locale }),
    all: citiesCentresPath(locale),
    path: (city: string) => centreDirectoryPath(locale, city),
  },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={
        description ??
        m.description({ cities: coveredCities(locale) }, { locale })
      }
    />
    <meta name="robots" content="noindex,follow" />
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/learnaprop-logo.png"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {m.skip({}, { locale })}
    </a>
    <header class="shell header">
      <a href={base} class="brand">
        <img
          src="/images/brand/learnaprop-logo.png"
          alt=""
          width="56"
          height="56"
        />
        UrbanLabs
      </a>
      <div class="header-actions">
        <nav
          class="primary-nav"
          aria-label={m.primaryNavigation({}, { locale })}
        >
          <a href={base} aria-current={section === 'home' ? 'page' : undefined}>
            {m.homeNav({}, { locale })}
          </a>
          {menus.map((menu) => (
            <details
              class="nav-menu"
              name="nav-menu"
              data-current={section === menu.section ? 'true' : undefined}
            >
              <summary>{menu.label}</summary>
              <ul>
                {cities.map((city) => (
                  <li>
                    <a href={menu.path(city.id)}>{city.label}</a>
                  </li>
                ))}
                <li>
                  <a href={menu.all}>{m.allCitiesNav({}, { locale })}</a>
                </li>
              </ul>
            </details>
          ))}
        </nav>
        <nav class="language-nav" aria-label={m.language({}, { locale })}>
          <a
            href={languagePaths.es}
            lang="es"
            aria-current={locale === 'es' ? 'page' : undefined}
          >
            {m.languageSpanish({}, { locale })}
          </a>
          <a
            href={languagePaths.ca}
            lang="ca"
            aria-current={locale === 'ca' ? 'page' : undefined}
          >
            {m.languageCatalan({}, { locale })}
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="shell footer">
      <div class="footer-about">
        <p class="footer-brand">UrbanLabs</p>
        <p>{m.footer({}, { locale })}</p>
      </div>
      <div class="footer-links">
        <a href={aboutPath(locale)}>{m.aboutNav({}, { locale })}</a>
        <a class="github-link" href="https://github.com/8beets/urbanlabs">
          <img src="/icons/github.svg" alt="" width="20" height="20" />
          {m.githubRepo({}, { locale })}
        </a>
        <p class="photo-credit">
          {m.photoNote({}, { locale })}{' '}
          <a href="https://www.pexels.com/">{m.photoCredits({}, { locale })}</a>
          .
        </p>
        {credits.map((credit) => (
          <p class="photo-credit">
            {m.cityDataNote({ city: credit.city }, { locale })}{' '}
            <a href={credit.url}>{credit.name}</a>.
          </p>
        ))}
      </div>
    </footer>
  </body>
</html>
