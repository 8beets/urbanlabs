---
import { m } from '../paraglide/messages.js';
import { courseSearchPath, centreDirectoryPath, homePath } from '../i18n/paths';
import { type Locale } from '../i18n/ui';
import '../styles/global.css';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  languagePaths: Record<Locale, string>;
  section?: 'home' | 'courses' | 'centres' | 'none';
}
const {
  locale,
  title,
  description,
  languagePaths,
  section = 'home',
} = Astro.props;
const base = homePath(locale);
const centreBase = centreDirectoryPath(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={description ?? m.description({}, { locale })}
    />
    <meta name="robots" content="noindex,follow" />
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/learnaprop-logo.png"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {m.skip({}, { locale })}
    </a>
    <header class="shell header">
      <a href={base} class="brand">
        <img
          src="/images/brand/learnaprop-logo.png"
          alt=""
          width="56"
          height="56"
        />
        UrbanLabs
      </a>
      <div class="header-actions">
        <nav
          class="primary-nav"
          aria-label={m.primaryNavigation({}, { locale })}
        >
          <a href={base} aria-current={section === 'home' ? 'page' : undefined}>
            {m.homeNav({}, { locale })}
          </a>
          <a
            href={courseSearchPath(locale)}
            aria-current={section === 'courses' ? 'page' : undefined}
          >
            {m.coursesNav({}, { locale })}
          </a>
          <a
            href={centreBase}
            aria-current={section === 'centres' ? 'page' : undefined}
          >
            {m.centresNav({}, { locale })}
          </a>
        </nav>
        <nav class="language-nav" aria-label={m.language({}, { locale })}>
          <a
            href={languagePaths.es}
            lang="es"
            aria-current={locale === 'es' ? 'page' : undefined}
          >
            {m.languageSpanish({}, { locale })}
          </a>
          <a
            href={languagePaths.ca}
            lang="ca"
            aria-current={locale === 'ca' ? 'page' : undefined}
          >
            {m.languageCatalan({}, { locale })}
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="shell footer">
      <div class="footer-about">
        <p class="footer-brand">UrbanLabs</p>
        <p>{m.footer({}, { locale })}</p>
      </div>
      <div class="footer-links">
        <a href={`${courseSearchPath(locale)}?archive=1`}>
          {m.archiveLink({}, { locale })}
        </a>
        <a class="github-link" href="https://github.com/8beets/urbanlabs">
          <img src="/icons/github.svg" alt="" width="20" height="20" />
          {m.githubRepo({}, { locale })}
        </a>
        <p class="photo-credit">
          {m.photoNote({}, { locale })}{' '}
          <a href="https://www.pexels.com/">{m.photoCredits({}, { locale })}</a>
          .
        </p>
        <p class="photo-credit">
          {m.zaragozaDataNote({}, { locale })}{' '}
          <a href="https://www.zaragoza.es/sede/portal/aviso-legal#condiciones">
            {m.zaragozaDataSource({}, { locale })}
          </a>
          .
        </p>
      </div>
    </footer>
  </body>
</html>
