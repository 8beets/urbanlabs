---
import { courseSearchPath } from '../i18n/paths';
import { messages, categoryLabel, type Locale } from '../i18n/ui';
import type { DiscoveryPageData } from '../lib/courses/page';
import Icon from './Icon.astro';
import LocationFilters from './LocationFilters.astro';

interface Props {
  locale: Locale;
  data: Pick<
    DiscoveryPageData,
    'filters' | 'centres' | 'categories' | 'error' | 'geography'
  >;
}
const { locale, data } = Astro.props;
const { filters, centres, categories, error } = data;
const t = messages[locale];
const base = courseSearchPath(locale);
// New filter controls belong in this same GET form. Omit page on submit to reset pagination.
const formFields = new Set([
  'q',
  'centre',
  'category',
  'maxPrice',
  'page',
  'country',
  'region',
  'city',
]);
const preservedParams = [...Astro.url.searchParams].filter(
  ([key]) => !formFields.has(key),
);
---

<aside class="filter-sidebar" aria-label={t.filters}>
  <details
    id="filter-panel"
    class="filter-panel"
    open
    data-invalid={error === 'invalid' ? 'true' : undefined}
  >
    <summary>{t.filters}</summary>
    <form
      action={base}
      method="get"
      class="filter-form"
      aria-label={t.submit}
      data-dynamic-filters
      data-locale={locale}
      data-all-centres={t.allCentres}
      data-all-categories={t.allCategories}
      data-loading={t.filtersLoading}
      data-failed={t.filtersFailed}
    >
      {preservedParams.map(([key, value]) => (
        <input type="hidden" name={key} value={value} />
      ))}
      <div>
        <label for="q">{t.search}</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder={t.searchExample}
          value={filters.q}
          aria-describedby={error === 'invalid' ? 'filter-error' : undefined}
        />
      </div>
      <fieldset class="filter-group">
        <legend>{t.refine}</legend>
        <LocationFilters locale={locale} data={data} />
        <div>
          <label for="centre">{t.centre}</label>
          <select id="centre" name="centre">
            <option value="" selected={!filters.centre}>
              {t.allCentres}
            </option>
            {filters.centre &&
              !centres.some((centre) => centre.id === filters.centre) && (
                <option value={filters.centre} selected>
                  {t.currentSelection}
                </option>
              )}
            {centres.map((centre) => (
              <option value={centre.id} selected={filters.centre === centre.id}>
                {centre.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="category">{t.category}</label>
          <select id="category" name="category">
            <option value="" selected={!filters.category}>
              {t.allCategories}
            </option>
            {filters.category && !categories.includes(filters.category) && (
              <option value={filters.category} selected>
                {categoryLabel(filters.category, locale)} ({t.currentSelection})
              </option>
            )}
            {categories.map((category) => (
              <option value={category} selected={filters.category === category}>
                {categoryLabel(category, locale)}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="maxPrice">{t.price}</label>
          <input
            id="maxPrice"
            name="maxPrice"
            type="number"
            min="0"
            max="9999.99"
            step="0.01"
            value={
              filters.maxPriceCents === null ? '' : filters.maxPriceCents / 100
            }
          />
        </div>
      </fieldset>
      <p
        class="filter-status"
        role="status"
        aria-live="polite"
        data-filter-status
        hidden
      ></p>
      <button type="submit">
        <Icon name="search" />
        {t.submit}
      </button>
    </form>
  </details>
</aside>

<script>
  import { enhanceFilters } from '../lib/courses/filter-controls';
  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-dynamic-filters]',
  ))
    enhanceFilters(form);
  const panel = document.querySelector<HTMLDetailsElement>('#filter-panel');
  if (panel) {
    const desktop = window.matchMedia('(min-width: 800px)');
    const updateLayout = () => {
      panel.open = desktop.matches || panel.dataset.invalid === 'true';
    };
    updateLayout();
    desktop.addEventListener('change', updateLayout);
  }
</script>
