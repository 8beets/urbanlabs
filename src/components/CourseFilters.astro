---
import { m } from '../paraglide/messages.js';
import { courseSearchPath } from '../i18n/paths';
import { audienceLabel, categoryLabel, type Locale } from '../i18n/ui';
import { AUDIENCES } from '../lib/courses/categories';
import type { DiscoveryPageData } from '../lib/catalog/discovery';
import { startMonthLabel } from '../lib/courses/start-month';
import Icon from './Icon.astro';
import LocationFilters from './LocationFilters.astro';

interface Props {
  locale: Locale;
  data: Pick<
    DiscoveryPageData,
    'filters' | 'centres' | 'categories' | 'error' | 'geography' | 'startMonths'
  >;
}
const { locale, data } = Astro.props;
const { filters, centres, categories, error, startMonths } = data;
const base = courseSearchPath(locale);
// New filter controls belong in this same GET form. Omit page on submit to reset pagination.
const formFields = new Set([
  'q',
  'centre',
  'category',
  'audience',
  'maxPrice',
  'start',
  'page',
  'country',
  'region',
  'city',
  'cancellation',
  'places',
]);
// The page is static: the browser search adds hidden inputs for other parameters
// (such as `archive`) so a submission keeps them.
---

<aside class="filter-sidebar" aria-label={m.filters({}, { locale })}>
  <details
    id="filter-panel"
    class="filter-panel"
    open
    data-invalid={error === 'invalid' ? 'true' : undefined}
  >
    <summary>{m.filters({}, { locale })}</summary>
    <form
      action={base}
      method="get"
      class="filter-form"
      aria-label={m.submit({}, { locale })}
      data-dynamic-filters
      data-form-fields={[...formFields].join(' ')}
      data-locale={locale}
      data-all-centres={m.allCentres({}, { locale })}
      data-all-categories={m.allCategories({}, { locale })}
    >
      <div>
        <label for="q">{m.search({}, { locale })}</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder={m.searchExample({}, { locale })}
          value={filters.q}
          aria-describedby={error === 'invalid' ? 'filter-error' : undefined}
        />
      </div>
      <fieldset class="filter-group">
        <legend>{m.refine({}, { locale })}</legend>
        <LocationFilters locale={locale} data={data} />
        <div>
          <label for="cancellation">
            {m.cancellationFilter({}, { locale })}
          </label>
          <select id="cancellation" name="cancellation">
            <option value="" selected={!filters.cancellation}>
              {m.allCancellation({}, { locale })}
            </option>
            <option value="hide" selected={filters.cancellation === 'hide'}>
              {m.hideCancelled({}, { locale })}
            </option>
            <option value="only" selected={filters.cancellation === 'only'}>
              {m.onlyCancelled({}, { locale })}
            </option>
          </select>
        </div>
        <div>
          <label for="places">{m.placesFilter({}, { locale })}</label>
          <select id="places" name="places">
            <option value="" selected={!filters.places}>
              {m.allPlaces({}, { locale })}
            </option>
            <option value="available" selected={filters.places === 'available'}>
              {m.hideSoldOut({}, { locale })}
            </option>
          </select>
        </div>
        <div>
          <label for="centre">{m.centre({}, { locale })}</label>
          <select id="centre" name="centre">
            <option value="" selected={!filters.centre}>
              {m.allCentres({}, { locale })}
            </option>
            {filters.centre &&
              !centres.some((centre) => centre.id === filters.centre) && (
                <option value={filters.centre} selected>
                  {m.currentSelection({}, { locale })}
                </option>
              )}
            {centres.map((centre) => (
              <option value={centre.id} selected={filters.centre === centre.id}>
                {centre.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="category">{m.category({}, { locale })}</label>
          <select id="category" name="category">
            <option value="" selected={!filters.category}>
              {m.allCategories({}, { locale })}
            </option>
            {filters.category && !categories.includes(filters.category) && (
              <option value={filters.category} selected>
                {categoryLabel(filters.category, locale)} (
                {m.currentSelection({}, { locale })})
              </option>
            )}
            {categories.map((category) => (
              <option value={category} selected={filters.category === category}>
                {categoryLabel(category, locale)}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="audience">{m.audience({}, { locale })}</label>
          <select id="audience" name="audience">
            <option value="" selected={!filters.audience}>
              {m.allAudiences({}, { locale })}
            </option>
            {AUDIENCES.map((audience) => (
              <option value={audience} selected={filters.audience === audience}>
                {audienceLabel(audience, locale)}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="start">{m.startMonth({}, { locale })}</label>
          <select id="start" name="start">
            <option value="" selected={!filters.startMonth}>
              {m.anyStartMonth({}, { locale })}
            </option>
            {filters.startMonth &&
              !startMonths.includes(filters.startMonth) && (
                <option value={filters.startMonth} selected>
                  {startMonthLabel(filters.startMonth, locale)} (
                  {m.currentSelection({}, { locale })})
                </option>
              )}
            {startMonths.map((month) => (
              <option value={month} selected={filters.startMonth === month}>
                {startMonthLabel(month, locale)}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="maxPrice">{m.price({}, { locale })}</label>
          <input
            id="maxPrice"
            name="maxPrice"
            type="number"
            min="0"
            max="9999.99"
            step="0.01"
            value={
              filters.maxPriceCents === null ? '' : filters.maxPriceCents / 100
            }
          />
        </div>
      </fieldset>
      <p
        class="filter-status"
        role="status"
        aria-live="polite"
        data-filter-status
        hidden
      ></p>
      <button type="submit">
        <Icon name="search" />
        {m.submit({}, { locale })}
      </button>
    </form>
  </details>
</aside>

<script>
  const panel = document.querySelector<HTMLDetailsElement>('#filter-panel');
  if (panel) {
    const desktop = window.matchMedia('(min-width: 800px)');
    const updateLayout = () => {
      panel.open = desktop.matches || panel.dataset.invalid === 'true';
    };
    updateLayout();
    desktop.addEventListener('change', updateLayout);
  }
</script>
