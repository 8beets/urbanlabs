---
import { m } from '../paraglide/messages.js';
import { centreDirectoryPath, localizedPaths } from '../i18n/paths';
import { cityLabel } from '../i18n/geography';
import type { City } from '../lib/locations/geography';
import { type Locale } from '../i18n/ui';
import type { DirectoryData } from '../lib/catalog/pages';
import CentreDirectoryMap from './CentreDirectoryMap.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
interface Props {
  locale: Locale;
  city: City;
  data: DirectoryData;
}
const { locale, city, data } = Astro.props;
const base = centreDirectoryPath(locale, city.id);
const title = m.cityCentresTitle({ city: cityLabel(city, locale) }, { locale });
---

<SiteLayout
  locale={locale}
  title={`${title} · UrbanLabs`}
  description={m.directoryIntro({}, { locale })}
  section="centres"
  languagePaths={localizedPaths((l) => centreDirectoryPath(l, city.id))}
>
  <section class="centre-heading">
    <h1>{title}</h1>
    <p class="intro">{m.directoryIntro({}, { locale })}</p>
  </section>
  {!data.centres.length && <p>{m.noCentres({}, { locale })}</p>}
  <CentreDirectoryMap
    locale={locale}
    base={base}
    centres={data.mapCentres}
    limited={data.mapHasMore}
  />
  {data.centres.length > 0 && (
    <form class="centre-search" role="search" data-centre-filter hidden>
      <label for="centre-q">{m.searchCentres({}, { locale })}</label>
      <input
        id="centre-q"
        type="search"
        name="q"
        maxlength="100"
        autocomplete="off"
        aria-controls="centre-list"
      />
    </form>
  )}
  <p role="status" aria-live="polite" data-centre-empty hidden>
    {m.noMatchingCentres({}, { locale })}
  </p>
  <div id="centre-list" class="grid centre-directory">
    {data.centres.map((centre) => (
      <article
        class="course"
        data-centre-name={`${centre.name} ${centre.address}`}
      >
        <h2>
          <a href={`${base}/${centre.slug}`}>{centre.name}</a>
        </h2>
        {centre.notice === 'temporary_closure' && (
          <p>
            <span class="closure-label">
              {m.temporarilyClosed({}, { locale })}
            </span>
          </p>
        )}
        <p>
          {centre.address}, {centre.city}
        </p>
        <a href={centre.official_url}>{m.website({}, { locale })} ↗</a>
      </article>
    ))}
  </div>
</SiteLayout>

<script>
  import { enhanceCentreFilter } from '../lib/institutions/directory-filter';
  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-centre-filter]',
  ))
    enhanceCentreFilter(form);
</script>
