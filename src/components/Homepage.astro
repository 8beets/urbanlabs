---
import { m } from '../paraglide/messages.js';
import { type Locale } from '../i18n/ui';
import { courseSearchPath, homePath } from '../i18n/paths';
import type { CourseListing } from '../lib/catalog/types';
import SiteLayout from '../layouts/SiteLayout.astro';
import CourseCard from './CourseCard.astro';
import Icon from './Icon.astro';
import ExpiredCards from './ExpiredCards.astro';
interface Props {
  locale: Locale;
  data: { courses: CourseListing[] };
}
const { locale, data } = Astro.props;
const themes = [
  { image: 'music', label: m.photoMusic({}, { locale }) },
  { image: 'pottery', label: m.photoPottery({}, { locale }) },
  { image: 'electronics', label: m.photoElectronics({}, { locale }) },
  { image: 'woodworking', label: m.photoWoodworking({}, { locale }) },
];
---

<SiteLayout
  locale={locale}
  title={m.pageTitle({}, { locale })}
  section="home"
  languagePaths={{ es: homePath('es'), ca: homePath('ca') }}
>
  <section class="hero" aria-labelledby="title">
    <div class="hero-copy">
      <p class="hero-location">
        <Icon name="pin" /> Barcelona
      </p>
      <h1 id="title">{m.title({}, { locale })}</h1>
      <p class="intro">{m.description({}, { locale })}</p>
      <a class="hero-link" href={courseSearchPath(locale)}>
        {m.explore({}, { locale })} <Icon name="arrow" />
      </a>
      <p class="hero-mission">{m.mission({}, { locale })}</p>
    </div>
    <div
      class="hero-photos"
      role="group"
      aria-label={m.photoNote({}, { locale })}
    >
      {themes.map((theme, index) => (
        <figure class={`theme-photo theme-photo-${index}`}>
          <img
            src={`/images/categories/${theme.image}.jpg`}
            alt=""
            width="800"
            height="600"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{theme.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section aria-labelledby="latest-courses" class="results latest-courses">
    <div class="results-heading">
      <div>
        <h2 id="latest-courses">{m.latestCourses({}, { locale })}</h2>
        <p class="results-intro">{m.latestCoursesIntro({}, { locale })}</p>
      </div>
      <a href={courseSearchPath(locale)}>
        {m.viewAllCourses({}, { locale })} <Icon name="arrow" />
      </a>
    </div>
    {!data.courses.length && <p>{m.latestEmpty({}, { locale })}</p>}
    <div class="grid">
      {data.courses.map((course) => (
        <CourseCard
          locale={locale}
          course={course}
          filterParams={new URLSearchParams()}
        />
      ))}
    </div>
  </section>
  <aside class="notice">
    <Icon name="info" />
    <p>{m.notice({}, { locale })}</p>
  </aside>
  <ExpiredCards />
</SiteLayout>
