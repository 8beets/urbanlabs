---
import { messages, type Locale } from '../i18n/ui';
import { courseSearchPath, homePath } from '../i18n/paths';
import type { HomepagePageData } from '../lib/courses/page';
import SiteLayout from '../layouts/SiteLayout.astro';
import CourseCard from './CourseCard.astro';
import Icon from './Icon.astro';
interface Props {
  locale: Locale;
  data: HomepagePageData;
}
const { locale, data } = Astro.props;
const t = messages[locale];
const themes = [
  { image: 'music', label: t.photoMusic },
  { image: 'pottery', label: t.photoPottery },
  { image: 'electronics', label: t.photoElectronics },
  { image: 'woodworking', label: t.photoWoodworking },
];
---

<SiteLayout
  locale={locale}
  title={t.pageTitle}
  section="home"
  languagePaths={{
    es: `${homePath('es')}${Astro.url.search}`,
    ca: `${homePath('ca')}${Astro.url.search}`,
  }}
>
  <section class="hero" aria-labelledby="title">
    <div class="hero-copy">
      <p class="hero-location">
        <Icon name="pin" /> Barcelona
      </p>
      <h1 id="title">{t.title}</h1>
      <p class="intro">{t.description}</p>
      <a class="hero-link" href={courseSearchPath(locale)}>
        {t.explore} <Icon name="arrow" />
      </a>
      <p class="hero-mission">{t.mission}</p>
    </div>
    <div class="hero-photos" role="group" aria-label={t.photoNote}>
      {themes.map((theme, index) => (
        <figure class={`theme-photo theme-photo-${index}`}>
          <img
            src={`/images/categories/${theme.image}.jpg`}
            alt=""
            width="800"
            height="600"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{theme.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section aria-labelledby="latest-courses" class="results latest-courses">
    <div class="results-heading">
      <div>
        <h2 id="latest-courses">{t.latestCourses}</h2>
        <p class="results-intro">{t.latestCoursesIntro}</p>
      </div>
      <a href={courseSearchPath(locale)}>
        {t.viewAllCourses} <Icon name="arrow" />
      </a>
    </div>
    {data.error && (
      <p role="alert" class="error">
        {t[data.error]}
      </p>
    )}
    {!data.error && !data.courses.length && <p>{t.latestEmpty}</p>}
    <div class="grid">
      {data.courses.map((course) => (
        <CourseCard
          locale={locale}
          course={course}
          filterParams={new URLSearchParams()}
        />
      ))}
    </div>
  </section>
  <aside class="notice">
    <Icon name="info" />
    <p>{t.notice}</p>
  </aside>
</SiteLayout>
