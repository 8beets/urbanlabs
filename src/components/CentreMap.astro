---
import { m } from '../paraglide/messages.js';
import { formatLocalDate, type Locale } from '../i18n/ui';
import InteractiveCentreMap from './InteractiveCentreMap.astro';
import type { SnapshotCentre } from '../lib/catalog/types';
import {
  openStreetMapLocation,
  openStreetMapSearch,
} from '../lib/institutions/maps';
interface Props {
  locale: Locale;
  centre: SnapshotCentre;
  /** The city's centre directory path; markers link below it. */
  base: string;
}
const { locale, centre, base } = Astro.props;
const map =
  centre.coordinates_source_url && centre.coordinates_verified_at
    ? openStreetMapLocation(centre.latitude, centre.longitude)
    : null;
---

<section class="centre-map" aria-labelledby="location">
  <h2 id="location">{m.location({}, { locale })}</h2>
  {map ? (
    <>
      <InteractiveCentreMap
        locale={locale}
        base={base}
        centres={[
          {
            id: centre.id,
            slug: centre.slug,
            name: centre.name,
            latitude: centre.latitude!,
            longitude: centre.longitude!,
          },
        ]}
        id="centre-location"
        title={`${m.mapOf({}, { locale })} ${centre.name}`}
      />
      <p>
        <a href={map.mapUrl}>{m.largerMap({}, { locale })} ↗</a> · ©{' '}
        <a href="https://www.openstreetmap.org/copyright">
          {m.mapContributors({}, { locale })}
        </a>
      </p>
      <p class="verified">
        <a href={centre.coordinates_source_url!}>
          {m.locationSource({}, { locale })}
        </a>{' '}
        · {m.verified({}, { locale })}{' '}
        {formatLocalDate(centre.coordinates_verified_at!, locale)}
      </p>
    </>
  ) : (
    <>
      <p>{m.mapUnavailable({}, { locale })}</p>
      <a href={openStreetMapSearch(centre.address, centre.city)}>
        {m.searchAddress({}, { locale })} ↗
      </a>
    </>
  )}
</section>
