---
import { m } from '../paraglide/messages.js';
import { type Locale } from '../i18n/ui';
import type { CentreMapPoint } from '../lib/catalog/types';
import InteractiveCentreMap from './InteractiveCentreMap.astro';
interface Props {
  locale: Locale;
  centres: CentreMapPoint[];
  limited: boolean;
}
const { locale, centres, limited } = Astro.props;
---

<section class="directory-map" aria-labelledby="directory-map-title">
  <h2 id="directory-map-title">{m.directoryMapTitle({}, { locale })}</h2>
  {centres.length ? (
    <>
      <p>{m.directoryMapIntro({}, { locale })}</p>
      <InteractiveCentreMap
        locale={locale}
        centres={centres}
        id="directory-map"
        title={m.directoryMapTitle({}, { locale })}
      />
      {limited && <p>{m.directoryMapLimited({}, { locale })}</p>}
    </>
  ) : (
    <p>{m.directoryMapNoLocations({}, { locale })}</p>
  )}
  <a href="#centre-list">{m.directoryMapFallback({}, { locale })}</a>
</section>
