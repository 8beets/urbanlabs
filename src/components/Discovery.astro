---
import { m } from '../paraglide/messages.js';
import {
  centreDirectoryPath,
  cityPath,
  courseSearchPath,
  localizedPaths,
} from '../i18n/paths';
import { cityLabel } from '../i18n/geography';
import type { City } from '../lib/locations/geography';
import { type Locale } from '../i18n/ui';
import type { DiscoveryPageData } from '../lib/catalog/discovery';
import { discoveryResultsHtml } from '../lib/catalog/discovery-view';
import type { OfficialSource } from '../lib/catalog/search-index';
import CourseFilters from './CourseFilters.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  city: City;
  /** The unfiltered search, prerendered; the browser renders every other query. */
  data: DiscoveryPageData;
  sources: OfficialSource[];
  /** Whether this build links to email alerts. */
  alerts: boolean;
}
const { locale, city, data, sources, alerts } = Astro.props;
const base = courseSearchPath(locale, city.id);
const name = cityLabel(city, locale);
const title = m.cityCoursesTitle({ city: name }, { locale });
---

<SiteLayout
  locale={locale}
  title={`${title} · UrbanLabs`}
  section="courses"
  languagePaths={localizedPaths((l) => courseSearchPath(l, city.id))}
>
  <section class="search-heading" aria-labelledby="title">
    <h1 id="title" data-search-title>
      {title}
    </h1>
    <p class="intro" data-search-intro>
      {m.searchIntro({}, { locale })}
    </p>
  </section>
  <noscript>
    <p class="notice search-noscript">
      {m.searchNeedsJavaScript({}, { locale })}{' '}
      <a href={cityPath(locale, city.id)}>
        {m.browseByCategory({}, { locale })}
      </a>
      {' · '}
      <a href={centreDirectoryPath(locale, city.id)}>
        {m.browseByCentre({}, { locale })}
      </a>
    </p>
  </noscript>
  <div
    id="discovery"
    class="discovery-layout"
    data-search-page
    data-locale={locale}
    data-city={city.id}
    data-alerts={alerts ? 'true' : 'false'}
  >
    <CourseFilters locale={locale} data={data} />
    {/* Hides the unfiltered prerendered results while a filtered search loads. */}
    <script is:inline>
      if (location.search) {
        const root = document.documentElement;
        root.setAttribute('data-search-pending', '');
        // If the search script never starts (it failed to download), stop waiting.
        setTimeout(() => {
          if (
            root.hasAttribute('data-search-pending') &&
            !document.querySelector('[data-discovery-results][aria-busy]')
          )
            root.setAttribute('data-search-failed', '');
        }, 8000);
      }
    </script>
    <div class="discovery-content">
      <p class="search-loading" role="status">
        {m.searchLoading({}, { locale })}
      </p>
      <p class="search-failed error" role="alert">
        {m.unavailable({}, { locale })}{' '}
        <a href={cityPath(locale, city.id)}>
          {m.browseByCategory({}, { locale })}
        </a>
        {' · '}
        <a href={centreDirectoryPath(locale, city.id)}>
          {m.browseByCentre({}, { locale })}
        </a>
      </p>
      <div
        data-discovery-results
        set:html={discoveryResultsHtml({
          locale,
          data,
          params: new URLSearchParams(),
          sources,
          alerts,
        })}
      />
    </div>
  </div>
  <p class="archive-link">
    <a href={`${base}?archive=1`}>{m.archiveLink({}, { locale })}</a>
  </p>
  <aside class="notice">
    <Icon name="info" />
    <p>{m.notice({}, { locale })}</p>
  </aside>
</SiteLayout>

<script>
  import { startSearchPage } from '../lib/catalog/search-page';
  const root = document.querySelector<HTMLElement>('[data-search-page]');
  if (root) void startSearchPage(root);
</script>
