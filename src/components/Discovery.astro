---
import { pageErrorMessage } from '../i18n/ui';
import { m } from '../paraglide/messages.js';
import { cityLabel, regionLabel } from '../i18n/geography';
import { courseSearchPath } from '../i18n/paths';
import { categoryLabel, type Locale } from '../i18n/ui';
import type { DiscoveryPageData } from '../lib/courses/page';
import { sources } from '../lib/sources';
import CourseFilters from './CourseFilters.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import CourseCard from './CourseCard.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  data: DiscoveryPageData;
}
const { locale, data } = Astro.props;
const { courses, centres, filters, hasNext, error } = data;
const officialSources = sources.filter((source) => {
  const city = data.geography.cities.find(
    (row) => row.id === source.institution.cityId,
  );
  return (
    (!filters.centre || source.institution.id === filters.centre) &&
    (!filters.country || source.institution.country === filters.country) &&
    (!filters.region || city?.region_id === filters.region) &&
    (!filters.city || city?.id === filters.city)
  );
});
const base = courseSearchPath(locale);
const appliedFilters: { key: string; label: string }[] = [];
if (filters.region) {
  const region = data.geography.regions.find(
    (row) => row.id === filters.region,
  );
  appliedFilters.push({
    key: 'region',
    label: `${m.region({}, { locale })}: ${region ? regionLabel(region, locale) : filters.region}`,
  });
}
if (filters.city) {
  const city = data.geography.cities.find((row) => row.id === filters.city);
  appliedFilters.push({
    key: 'city',
    label: `${m.city({}, { locale })}: ${city ? cityLabel(city, locale) : filters.city}`,
  });
}
if (filters.q)
  appliedFilters.push({
    key: 'q',
    label: `${m.search({}, { locale })}: ${filters.q}`,
  });
if (filters.cancellation)
  appliedFilters.push({
    key: 'cancellation',
    label:
      filters.cancellation === 'only'
        ? m.onlyCancelled({}, { locale })
        : m.hideCancelled({}, { locale }),
  });
if (filters.centre)
  appliedFilters.push({
    key: 'centre',
    label: `${m.centre({}, { locale })}: ${centres.find((centre) => centre.id === filters.centre)?.name ?? m.currentSelection({}, { locale })}`,
  });
if (filters.category)
  appliedFilters.push({
    key: 'category',
    label: `${m.category({}, { locale })}: ${categoryLabel(filters.category, locale)}`,
  });
if (filters.maxPriceCents !== null)
  appliedFilters.push({
    key: 'maxPrice',
    label: `${m.price({}, { locale })}: ${new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR' }).format(filters.maxPriceCents / 100)}`,
  });
function pageUrl(page: number) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(page));
  return `${base}?${params}`;
}
function filterUrl(key: string, value: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete('page');
  if (value) params.set(key, value);
  else params.delete(key);
  return params.size ? `${base}?${params}` : base;
}
---

<SiteLayout
  locale={locale}
  title={m.searchPageTitle({}, { locale })}
  section="courses"
  languagePaths={{
    es: `${courseSearchPath('es')}${Astro.url.search}`,
    ca: `${courseSearchPath('ca')}${Astro.url.search}`,
  }}
>
  <section class="search-heading" aria-labelledby="title">
    <h1 id="title">{m.searchTitle({}, { locale })}</h1>
    <p class="intro">{m.searchIntro({}, { locale })}</p>
  </section>
  <div id="discovery" class="discovery-layout">
    <CourseFilters locale={locale} data={data} />
    <div class="discovery-content">
      {error && (
        <p role="alert" id="filter-error" class="error">
          {pageErrorMessage(error, locale)}
        </p>
      )}
      <section aria-labelledby="results" class="results">
        <div class="results-heading">
          <div>
            <h2 id="results">{m.results({}, { locale })}</h2>
            <p class="results-intro">{m.resultsIntro({}, { locale })}</p>
          </div>
          {(appliedFilters.length > 0 ||
            filters.page > 1 ||
            error === 'invalid') && (
            <a href={base}>{m.clear({}, { locale })}</a>
          )}
        </div>
        {appliedFilters.length > 0 && (
          <div
            class="applied-filters"
            aria-label={m.appliedFilters({}, { locale })}
            role="group"
          >
            <p>{m.appliedFilters({}, { locale })}</p>
            <ul>
              {appliedFilters.map((filter) => (
                <li>
                  <a
                    href={filterUrl(filter.key, '')}
                    aria-label={`${m.removeFilter({}, { locale })}: ${filter.label}`}
                  >
                    {filter.label}
                    <span aria-hidden="true"> ×</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {!error && courses.length === 0 && (
          <div class="empty">
            <h3>{m.empty({}, { locale })}</h3>
            <p>
              {officialSources.length
                ? m.emptyHelp({}, { locale })
                : m.emptyLocation({}, { locale })}
            </p>
            {officialSources.map((source) => (
              <p>
                <a href={source.listingUrl}>
                  {m.programming({}, { locale })}: {source.institution.name} ↗
                </a>
              </p>
            ))}
          </div>
        )}
        <div class="grid">
          {courses.map((course) => (
            <CourseCard
              locale={locale}
              course={course}
              filterParams={Astro.url.searchParams}
            />
          ))}
        </div>
        <nav class="pagination" aria-label={m.pagination({}, { locale })}>
          {filters.page > 1 && (
            <a href={pageUrl(filters.page - 1)} rel="prev">
              ← {m.previous({}, { locale })}
            </a>
          )}
          {hasNext && filters.page < 1000 && (
            <a href={pageUrl(filters.page + 1)} rel="next">
              {m.next({}, { locale })} →
            </a>
          )}
        </nav>
      </section>
    </div>
  </div>
  <aside class="notice">
    <Icon name="info" />
    <p>{m.notice({}, { locale })}</p>
  </aside>
</SiteLayout>
