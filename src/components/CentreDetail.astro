---
import { m } from '../paraglide/messages.js';
import { centreDirectoryPath, centrePath, localizedPaths } from '../i18n/paths';
import { formatLocalDate, type Locale } from '../i18n/ui';
import type { SnapshotCentre, CourseListing } from '../lib/catalog/types';
import SiteLayout from '../layouts/SiteLayout.astro';
import CentreMap from './CentreMap.astro';
import CourseCard from './CourseCard.astro';
import ExpiredCards from './ExpiredCards.astro';
interface Props {
  locale: Locale;
  city: string;
  centre: SnapshotCentre;
  courses: CourseListing[];
  page: number;
  prevUrl?: string | undefined;
  nextUrl?: string | undefined;
}
const { locale, city, centre, courses, page, prevUrl, nextUrl } = Astro.props;
const base = centreDirectoryPath(locale, city);
const suffix = page > 1 ? `/${page}` : '';
const paths = localizedPaths(
  (l) => `${centrePath(l, city, centre.slug)}${suffix}`,
);
const courseParams = new URLSearchParams({ centre: centre.id });
---

<SiteLayout
  locale={locale}
  title={`${centre.name} · UrbanLabs`}
  section="centres"
  languagePaths={paths}
>
  <p class="breadcrumb">
    <a href={base}>← {m.centresNav({}, { locale })}</a>
  </p>
  <>
    <section class="centre-heading">
      <h1>{centre.name}</h1>
      {centre.description && (
        <p class="intro" lang={centre.description_language ?? undefined}>
          {centre.description}
        </p>
      )}
      {centre.notice === 'temporary_closure' && (
        <p class="error">{m.closureNotice({}, { locale })}</p>
      )}
      <h2>{m.centreDetails({}, { locale })}</h2>
      <dl class="centre-contact">
        <dt>{m.address({}, { locale })}</dt>
        <dd>
          {centre.address}, {centre.city}
        </dd>
        <dt>{m.website({}, { locale })}</dt>
        <dd>
          <a href={centre.official_url}>{centre.name} ↗</a>
        </dd>
        {centre.phone && (
          <>
            <dt>{m.phone({}, { locale })}</dt>
            <dd>
              <a href={`tel:${centre.phone.replace(/[^+0-9]/g, '')}`}>
                {centre.phone}
              </a>
            </dd>
          </>
        )}
        {centre.email && (
          <>
            <dt>{m.email({}, { locale })}</dt>
            <dd>
              <a href={`mailto:${centre.email}`}>{centre.email}</a>
            </dd>
          </>
        )}
      </dl>
      {centre.details_source_url && (
        <p class="verified">
          <a href={centre.details_source_url}>
            {m.detailsSource({}, { locale })}
          </a>
          {centre.details_verified_at && (
            <>
              {' '}
              · {m.verified({}, { locale })}{' '}
              {formatLocalDate(centre.details_verified_at, locale)}
            </>
          )}
        </p>
      )}
    </section>
    <CentreMap locale={locale} centre={centre} base={base} />
    <section class="centre-courses" aria-labelledby="centre-courses">
      <h2 id="centre-courses">{m.centreCourses({}, { locale })}</h2>
      {!courses.length && <p>{m.noCentreCourses({}, { locale })}</p>}
      <div class="grid">
        {courses.map((course) => (
          <CourseCard
            locale={locale}
            course={course}
            filterParams={courseParams}
          />
        ))}
      </div>
      <nav class="pagination" aria-label={m.pagination({}, { locale })}>
        {prevUrl && (
          <a href={prevUrl} rel="prev">
            ← {m.previous({}, { locale })}
          </a>
        )}
        {nextUrl && (
          <a href={nextUrl} rel="next">
            {m.next({}, { locale })} →
          </a>
        )}
      </nav>
      <aside class="notice">{m.notice({}, { locale })}</aside>
      <ExpiredCards />
    </section>
  </>
</SiteLayout>
