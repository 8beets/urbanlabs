---
import { pageErrorMessage } from '../i18n/ui';
import { m } from '../paraglide/messages.js';
import { centreDirectoryPath } from '../i18n/paths';
import { formatLocalDate, type Locale } from '../i18n/ui';
import type { CentrePageData } from '../lib/institutions/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import CentreMap from './CentreMap.astro';
import CourseCard from './CourseCard.astro';
interface Props {
  locale: Locale;
  data: CentrePageData;
}
const { locale, data } = Astro.props;
const { centre } = data;
const base = centreDirectoryPath(locale);
const paths = {
  es: `${centreDirectoryPath('es')}/${centre?.slug ?? Astro.params.slug}${Astro.url.search}`,
  ca: `${centreDirectoryPath('ca')}/${centre?.slug ?? Astro.params.slug}${Astro.url.search}`,
};
const courseParams = new URLSearchParams(centre ? { centre: centre.id } : {});
---

<SiteLayout
  locale={locale}
  title={`${centre?.name ?? m.notFound({}, { locale })} · UrbanLabs`}
  section="centres"
  languagePaths={paths}
>
  <p class="breadcrumb">
    <a href={base}>← {m.centresNav({}, { locale })}</a>
  </p>
  {data.error && (
    <>
      <h1>{pageErrorMessage(data.error, locale)}</h1>
      <p>
        <a href={base}>{m.directoryTitle({}, { locale })}</a>
      </p>
    </>
  )}
  {centre && (
    <>
      <section class="centre-heading">
        <h1>{centre.name}</h1>
        {centre.description && (
          <p class="intro" lang={centre.description_language ?? undefined}>
            {centre.description}
          </p>
        )}
        {centre.notice === 'temporary_closure' && (
          <p class="error">{m.closureNotice({}, { locale })}</p>
        )}
        <h2>{m.centreDetails({}, { locale })}</h2>
        <dl class="centre-contact">
          <dt>{m.address({}, { locale })}</dt>
          <dd>
            {centre.address}, {centre.city}
          </dd>
          <dt>{m.website({}, { locale })}</dt>
          <dd>
            <a href={centre.official_url}>{centre.name} ↗</a>
          </dd>
          {centre.phone && (
            <>
              <dt>{m.phone({}, { locale })}</dt>
              <dd>
                <a href={`tel:${centre.phone.replace(/[^+0-9]/g, '')}`}>
                  {centre.phone}
                </a>
              </dd>
            </>
          )}
          {centre.email && (
            <>
              <dt>{m.email({}, { locale })}</dt>
              <dd>
                <a href={`mailto:${centre.email}`}>{centre.email}</a>
              </dd>
            </>
          )}
        </dl>
        {centre.details_source_url && (
          <p class="verified">
            <a href={centre.details_source_url}>
              {m.detailsSource({}, { locale })}
            </a>
            {centre.details_verified_at && (
              <>
                {' '}
                · {m.verified({}, { locale })}{' '}
                {formatLocalDate(centre.details_verified_at, locale)}
              </>
            )}
          </p>
        )}
      </section>
      <CentreMap locale={locale} centre={centre} />
      <section class="centre-courses" aria-labelledby="centre-courses">
        <h2 id="centre-courses">{m.centreCourses({}, { locale })}</h2>
        {!data.courses.length && <p>{m.noCentreCourses({}, { locale })}</p>}
        <div class="grid">
          {data.courses.map((course) => (
            <CourseCard
              locale={locale}
              course={course}
              filterParams={courseParams}
            />
          ))}
        </div>
        <nav class="pagination" aria-label={m.pagination({}, { locale })}>
          {data.page > 1 && (
            <a href={`${base}/${centre.slug}?page=${data.page - 1}`} rel="prev">
              ← {m.previous({}, { locale })}
            </a>
          )}
          {data.hasNext && data.page < 1000 && (
            <a href={`${base}/${centre.slug}?page=${data.page + 1}`} rel="next">
              {m.next({}, { locale })} →
            </a>
          )}
        </nav>
        <aside class="notice">{m.notice({}, { locale })}</aside>
      </section>
    </>
  )}
</SiteLayout>
