---
import { m } from '../paraglide/messages.js';
import { type Locale } from '../i18n/ui';
import type { CentreMapLabels } from '../lib/institutions/centre-map';
import type { CentreMapPoint } from '../lib/catalog/types';
interface Props {
  locale: Locale;
  centres: CentreMapPoint[];
  /** The city's centre directory path; markers link below it. */
  base: string;
  id: string;
  title: string;
}
const { locale, centres, base, id, title } = Astro.props;
const labels: CentreMapLabels = {
  mapContributors: m.mapContributors({}, { locale }),
  loading: m.mapLoading({}, { locale }),
  failed: m.mapFailed({}, { locale }),
  tilesFailed: m.mapTilesFailed({}, { locale }),
  zoomIn: m.zoomIn({}, { locale }),
  zoomOut: m.zoomOut({}, { locale }),
};
---

<div
  class="interactive-centre-map"
  data-centre-map
  data-centres={JSON.stringify(centres)}
  data-centre-base={base}
  data-labels={JSON.stringify(labels)}
>
  <div
    class="centre-map-canvas"
    data-map-canvas
    role="region"
    aria-label={title}
    aria-describedby={`${id}-keyboard`}
    hidden
  ></div>
  <p data-map-status role="status" hidden></p>
  <p id={`${id}-keyboard`} data-map-help hidden>
    {m.mapKeyboard({}, { locale })}
  </p>
</div>
<script>
  import { initializeCentreMaps } from '../lib/institutions/centre-map';
  initializeCentreMaps();
</script>
