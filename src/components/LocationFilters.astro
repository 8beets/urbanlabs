---
import { m } from '../paraglide/messages.js';
import { cityLabel, regionLabel } from '../i18n/geography';
import { type Locale } from '../i18n/ui';
import type { DiscoveryPageData } from '../lib/catalog/discovery';
interface Props {
  locale: Locale;
  data: Pick<DiscoveryPageData, 'filters' | 'geography'>;
}
const {
  locale,
  data: { filters, geography },
} = Astro.props;
const regions = geography.regions.filter(
  (row) => row.country_code === filters.country,
);
const cities = geography.cities.filter(
  (row) =>
    row.country_code === filters.country &&
    (!filters.region || row.region_id === filters.region),
);
const catalog = geography.cities.filter(
  (row) => row.country_code === filters.country,
);
---

<div
  data-location-filters
  data-cities={JSON.stringify(
    catalog.map((city) => ({ ...city, name: cityLabel(city, locale) })),
  )}
  data-all-cities={m.allCities({}, { locale })}
>
  <input type="hidden" name="country" value={filters.country ?? 'ES'} />
  <div>
    <label for="region">{m.region({}, { locale })}</label>
    <select id="region" name="region">
      <option value="" selected={!filters.region}>
        {m.allRegions({}, { locale })}
      </option>
      {regions.map((row) => (
        <option value={row.id} selected={filters.region === row.id}>
          {regionLabel(row, locale)}
        </option>
      ))}
    </select>
  </div>
  <div>
    <label for="city">{m.city({}, { locale })}</label>
    <select id="city" name="city">
      <option value="" selected={!filters.city}>
        {m.allCities({}, { locale })}
      </option>
      {cities.map((row) => (
        <option value={row.id} selected={filters.city === row.id}>
          {cityLabel(row, locale)}
        </option>
      ))}
    </select>
  </div>
</div>
<script>
  import type { City } from '../lib/locations/geography';
  for (const group of document.querySelectorAll<HTMLElement>(
    '[data-location-filters]',
  )) {
    const region = group.querySelector('[name="region"]');
    const city = group.querySelector('[name="city"]');
    if (
      !(region instanceof HTMLSelectElement) ||
      !(city instanceof HTMLSelectElement)
    )
      continue;
    const cities: City[] = JSON.parse(group.dataset.cities ?? '[]');
    region.addEventListener('change', () => {
      city.replaceChildren(new Option(group.dataset.allCities ?? '', ''));
      for (const row of cities) {
        if (!region.value || row.region_id === region.value)
          city.add(new Option(row.name, row.id));
      }
    });
  }
</script>

<style>
  [data-location-filters] {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
</style>
