---
import { m } from '../paraglide/messages.js';
import { courseSearchPath, centreDirectoryPath, homePath } from '../i18n/paths';
import SiteLayout from '../layouts/SiteLayout.astro';

const locale = Astro.url.pathname.split('/')[1] === 'ca' ? 'ca' : 'es';
Astro.response.status = 404;
---

<SiteLayout
  locale={locale}
  title={`404 · ${m.pageNotFound({}, { locale })} · UrbanLabs`}
  description={m.pageNotFoundIntro({}, { locale })}
  section="none"
  languagePaths={{ es: '/es/404', ca: '/ca/404' }}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="error-code">404</p>
    <h1 id="not-found-title">{m.pageNotFound({}, { locale })}</h1>
    <p class="intro">{m.pageNotFoundIntro({}, { locale })}</p>
    <ul>
      <li>
        <a href={homePath(locale)}>{m.homeNav({}, { locale })}</a>
      </li>
      <li>
        <a href={courseSearchPath(locale)}>{m.searchTitle({}, { locale })}</a>
      </li>
      <li>
        <a href={centreDirectoryPath(locale)}>{m.centresNav({}, { locale })}</a>
      </li>
    </ul>
  </section>
</SiteLayout>

<style>
  .not-found {
    margin-block: 28px 48px;
    padding: clamp(24px, 4vw, 64px);
    background: var(--sky);
    border-radius: 24px;
  }
  .error-code {
    margin: 0;
    font-weight: 700;
  }
  h1 {
    max-width: 20ch;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 650;
  }
</style>
