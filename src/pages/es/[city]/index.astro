---
import type { GetStaticPaths } from 'astro';
import CityHome from '../../../components/CityHome.astro';
import { loadCategoryPages, loadCities } from '../../../lib/catalog/pages';
import type { City } from '../../../lib/locations/geography';

export const getStaticPaths = (() => {
  const topics = loadCategoryPages();
  return loadCities().map(({ city }) => ({
    params: { city: city.id },
    props: { city, topics: topics.filter((page) => page.city === city.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  city: City;
  topics: ReturnType<typeof loadCategoryPages>;
}
const { city, topics } = Astro.props;
---

<CityHome locale="es" city={city} topics={topics} />
