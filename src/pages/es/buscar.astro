---
import { env } from 'cloudflare:workers';
import Discovery from '../../components/Discovery.astro';
import { loadDiscoveryPage } from '../../lib/courses/page';
import { alertsConfigured } from '../../lib/alerts/page';
const data = await loadDiscoveryPage(env.DB, Astro.url.searchParams);
if (data.canonicalQuery !== undefined)
  return Astro.redirect(
    `/es/buscar${data.canonicalQuery ? '?' + data.canonicalQuery : ''}`,
    302,
  );
Astro.response.status = data.status;
---

<Discovery locale="es" data={data} alerts={alertsConfigured(env)} />
