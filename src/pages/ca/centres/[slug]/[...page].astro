---
import type { GetStaticPaths, Page } from 'astro';
import CentreDetail from '../../../../components/CentreDetail.astro';
import { loadCentrePages } from '../../../../lib/catalog/pages';
import { PAGE_SIZE } from '../../../../lib/catalog/query';
import type { Centre, CourseListing } from '../../../../lib/catalog/types';

export const getStaticPaths = (({ paginate }) =>
  loadCentrePages().flatMap(({ centre, courses }) =>
    paginate(courses, {
      pageSize: PAGE_SIZE,
      params: { slug: centre.slug },
      props: { centre },
    }),
  )) satisfies GetStaticPaths;

interface Props {
  centre: Centre;
  page: Page<CourseListing>;
}
const { centre, page } = Astro.props;
---

<CentreDetail
  locale="ca"
  centre={centre}
  courses={page.data}
  page={page.currentPage}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
/>
